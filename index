// Edge Function: handout-download
// Ablauf:
//   POST ?action=request   {name, email, slug, newsletter:true, website:""}
//        → legt Anfrage mit zufälligem Token an und startet bei Brevo das Double-Opt-In.
//          Brevo leitet NACH dem Klick auf den Bestätigungslink auf
//          https://bizdenbize.com/handout.html?h=<slug>&t=<token> weiter.
//        → Antwort {status:"confirm"}  (Bestätigungsmail unterwegs)
//          oder   {status:"ready", url} (Adresse ist bei Brevo schon bekannt: Download sofort)
//   POST ?action=download  {slug, token}
//        → prüft den Token und liefert einen 10 Minuten gültigen Download-Link.
//
// Deploy (wie "newsletter": Verify JWT AUS, die Seite ruft anonym auf):
//   supabase functions deploy handout-download --no-verify-jwt
//   oder im Dashboard: Edge Functions → handout-download → "Verify JWT" ausschalten.
//
// Secrets (Projekt-weit, bei "newsletter" schon gesetzt): BREVO_API_KEY, BREVO_LIST_ID,
//   BREVO_DOI_TEMPLATE_ID. Optional: BREVO_HANDOUT_DOI_TEMPLATE_ID = eigene Vorlage
//   mit Text "Bestätige deine E-Mail, um das PDF zu erhalten" (muss den DOI-Link enthalten).
// SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stehen in Edge Functions automatisch bereit.
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const SITE = 'https://bizdenbize.com';
const ALLOWED_ORIGINS = [SITE, 'https://www.bizdenbize.com'];
const LINK_SECONDS = 600;                 // Signed URL: 10 Minuten
const TOKEN_DAYS = 7;                     // Bestätigungs-Token gültig für 7 Tage
const MAX_PER_EMAIL_PER_HOUR = 10;

function cors(origin: string | null) {
  const o = origin && ALLOWED_ORIGINS.includes(origin) ? origin : ALLOWED_ORIGINS[0];
  return {
    'Access-Control-Allow-Origin': o,
    'Access-Control-Allow-Headers': 'content-type, apikey, authorization',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Vary': 'Origin',
  };
}
function json(body: unknown, status: number, origin: string | null) {
  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json', ...cors(origin) } });
}
async function sha256(s: string) {
  const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
  return [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, '0')).join('');
}
function newToken() {
  const a = new Uint8Array(32); crypto.getRandomValues(a);
  return [...a].map((x) => x.toString(16).padStart(2, '0')).join('');
}

// Brevo Double-Opt-In. Der Kontakt kommt ERST nach dem Klick in die Liste.
async function brevoDoi(email: string, redirect: string): Promise<'sent' | 'exists' | 'error'> {
  const key = Deno.env.get('BREVO_API_KEY');
  const listId = Number(Deno.env.get('BREVO_LIST_ID') ?? '0');
  const templateId = Number(Deno.env.get('BREVO_HANDOUT_DOI_TEMPLATE_ID') ?? Deno.env.get('BREVO_DOI_TEMPLATE_ID') ?? '0');
  if (!key || !listId || !templateId) { console.error('Brevo-Konfiguration unvollständig', { key: !!key, listId, templateId }); return 'error'; }
  try {
    const r = await fetch('https://api.brevo.com/v3/contacts/doubleOptinConfirmation', {
      method: 'POST',
      headers: { 'api-key': key, 'Content-Type': 'application/json', accept: 'application/json' },
      // Kein "attributes"-Feld: Brevo lehnt den Aufruf ab, wenn ein Attribut im Konto fehlt.
      body: JSON.stringify({ email, includeListIds: [listId], templateId, redirectionUrl: redirect }),
    });
    if (r.status === 201 || r.status === 204) return 'sent';
    const text = await r.text();
    if (r.status === 400 && /duplicate|already/i.test(text)) return 'exists';
    console.error('Brevo-Fehler', r.status, text.slice(0, 300));
    return 'error';
  } catch (e) {
    console.error('Brevo-Aufruf fehlgeschlagen:', e instanceof Error ? e.message : e);
    return 'error';
  }
}

Deno.serve(async (req) => {
  const origin = req.headers.get('origin');
  if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors(origin) });
  if (req.method !== 'POST') return json({ error: 'method' }, 405, origin);

  const action = new URL(req.url).searchParams.get('action');
  let b: Record<string, unknown>;
  try { b = await req.json(); } catch { return json({ error: 'bad json' }, 400, origin); }

  const sb = createClient(Deno.env.get('SUPABASE_URL')!, Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!, { auth: { persistSession: false } });
  const slug = String(b.slug ?? '').trim();
  if (!/^[a-z0-9-]{3,60}$/.test(slug)) return json({ error: 'slug' }, 400, origin);

  const sign = () => sb.storage.from('handouts')
    .createSignedUrl(`${slug}.pdf`, LINK_SECONDS, { download: `Dersimiz-Almanya-${slug}.pdf` });
  const signFail = (msg?: string) => {
    const missing = /not found|does not exist/i.test(msg ?? '');
    return json({ error: missing ? 'not found' : 'storage' }, missing ? 404 : 500, origin);
  };

  // ---------- Token einlösen (Seite wurde von Brevo nach der Bestätigung aufgerufen) ----------
  if (action === 'download') {
    const token = String(b.token ?? '');
    if (!/^[a-f0-9]{64}$/.test(token)) return json({ error: 'invalid' }, 403, origin);
    const hash = await sha256(token);
    const { data: lead } = await sb.from('handout_leads').select('id, confirmed_at')
      .eq('token_hash', hash).eq('handout_slug', slug).gt('token_expires_at', new Date().toISOString()).maybeSingle();
    if (!lead) return json({ error: 'invalid' }, 403, origin);
    const { data: signed, error } = await sign();
    if (error || !signed?.signedUrl) return signFail(error?.message);
    if (!lead.confirmed_at) await sb.from('handout_leads').update({ confirmed_at: new Date().toISOString() }).eq('id', lead.id);
    return json({ url: signed.signedUrl, expires_in: LINK_SECONDS }, 200, origin);
  }

  // ---------- Anfrage: Double-Opt-In starten ----------
  if (action === 'request') {
    if (typeof b.website === 'string' && b.website.trim() !== '') return json({ error: 'rejected' }, 400, origin); // Honeypot
    const name = String(b.name ?? '').replace(/[\u0000-\u001f\u007f]/g, '').trim();
    const email = String(b.email ?? '').trim().toLowerCase();
    if (b.newsletter !== true) return json({ error: 'newsletter consent required' }, 400, origin);
    if (name.length < 2 || name.length > 80) return json({ error: 'name' }, 400, origin);
    if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/.test(email)) return json({ error: 'email' }, 400, origin);

    const since = new Date(Date.now() - 3600_000).toISOString();
    const { count } = await sb.from('handout_leads').select('id', { count: 'exact', head: true }).eq('email', email).gte('created_at', since);
    if ((count ?? 0) >= MAX_PER_EMAIL_PER_HOUR) return json({ error: 'rate' }, 429, origin);

    // Existiert die PDF-Datei? (Link wird hier nicht ausgeliefert, nur geprüft.)
    const probe = await sign();
    if (probe.error || !probe.data?.signedUrl) return signFail(probe.error?.message);

    const token = newToken();
    const { data: row, error: iErr } = await sb.from('handout_leads').insert({
      name, email, handout_slug: slug, newsletter_requested: true,
      token_hash: await sha256(token),
      token_expires_at: new Date(Date.now() + TOKEN_DAYS * 86400_000).toISOString(),
    }).select('id').single();
    if (iErr || !row) { console.error('insert failed', iErr); return json({ error: 'db' }, 500, origin); }

    const redirect = `${SITE}/handout.html?h=${encodeURIComponent(slug)}&t=${token}`;
    const res = await brevoDoi(email, redirect);

    if (res === 'sent') return json({ status: 'confirm' }, 200, origin);

    if (res === 'exists') {
      // Adresse ist bei Brevo schon bekannt: keine neue Bestätigungsmail möglich, Download sofort.
      await sb.from('handout_leads').update({ confirmed_at: new Date().toISOString() }).eq('id', row.id);
      return json({ status: 'ready', url: probe.data.signedUrl, expires_in: LINK_SECONDS }, 200, origin);
    }

    await sb.from('handout_leads').delete().eq('id', row.id); // fehlgeschlagene Anfrage nicht stehen lassen
    return json({ error: 'upstream' }, 502, origin);
  }

  return json({ error: 'unknown_action' }, 400, origin);
});
